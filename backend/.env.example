# =============================================================
# NFT Marketplace - Backend Environment Variables
# =============================================================
# Salin file ini menjadi .env dan isi nilai yang sesuai.
# Jangan pernah commit file .env ke Git!
# =============================================================


# ─── DATABASE ────────────────────────────────────────────────

# [LOKAL] SQLite (untuk development di laptop)
# DATABASE_URL="file:./dev.db"

# [PRODUCTION] Supabase PostgreSQL
# Ambil dari: Supabase Dashboard → Project Settings → Database → Connection String
#
# 1. DATABASE_URL → gunakan "Session Pooler" (IPv4, cocok untuk Render/server biasa)
#    Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"

# 2. DIRECT_URL → gunakan "Direct Connection" (hanya untuk `prisma migrate` dari lokal)
#    Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"


# ─── SERVER ──────────────────────────────────────────────────

PORT=3001


# ─── BLOCKCHAIN ──────────────────────────────────────────────

# [LOKAL] Hardhat local node
# RPC_URL=http://127.0.0.1:8545

# [PRODUCTION] Alchemy / Infura RPC URL (Sepolia Testnet)
# Daftar gratis di: https://alchemy.com → buat app "Ethereum Sepolia" → copy HTTPS URL
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/[YOUR_ALCHEMY_API_KEY]

# Alamat smart contract setelah di-deploy ke testnet
NFT_CONTRACT_ADDRESS=
MARKETPLACE_CONTRACT_ADDRESS=

# Block awal saat kontrak di-deploy (isi dengan deployment block number)
# Cek di Sepolia Etherscan → cari hash transaksi deploy → lihat block number
FROM_BLOCK=0

# Interval polling indexer dalam milidetik (default 5 detik)
# Untuk GitHub Actions cron job, nilai ini tidak relevan
POLL_INTERVAL_MS=5000


# ─── PINATA / IPFS ───────────────────────────────────────────

# Daftar gratis di: https://pinata.cloud → API Keys → New Key
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=