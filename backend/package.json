{
  "name": "nft-marketplace-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.20.1",
    "prisma": "^6.7.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
}